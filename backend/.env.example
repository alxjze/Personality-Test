# ─── Psikologia Career backend configuration ───────────────────────────
# Copy to .env (outside public_html on Hostinger) and fill in real values.
# NEVER commit .env or put secrets in the frontend.

APP_ENV=production            # production | development | testing
APP_DEBUG=false               # only honoured outside production
APP_URL=https://psikologia.id # used to build password-reset links
# STORAGE_PATH=/home/uXXXX/domains/psikologia.id/psikologia-app/storage
# LOG_CHANNEL=file            # file | stderr (use stderr on Vercel)
# TRUSTED_IP_HEADER=          # e.g. CF-Connecting-IP when behind Cloudflare; leave empty otherwise

# Database (Hostinger: host 127.0.0.1 or localhost from the website itself)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u000000000_psikologia
DB_USERNAME=u000000000_psikologia
DB_PASSWORD=change-me
# DB_SOCKET=

# Sessions (database driver works on shared hosting and serverless)
SESSION_DRIVER=database
SESSION_NAME=psk_session
SESSION_LIFETIME_MINUTES=10080
SESSION_SECURE_COOKIE=true

# AI provider: mock | openai | anthropic
# With AI_PROVIDER=mock (or no AI_API_KEY) every AI result is labelled "Simulasi".
AI_PROVIDER=mock
AI_MODEL=                     # e.g. claude-opus-5-5 (anthropic default) or your chosen OpenAI model
AI_API_KEY=
# AI_BASE_URL=                # optional OpenAI-compatible gateway URL
AI_TIMEOUT_SECONDS=90
AI_MAX_TOKENS=8000
AI_EFFORT=medium              # anthropic only: low | medium | high | xhigh | max | none

# Mail (password reset). log = write to storage/logs; mail = PHP mail() (Hostinger)
MAIL_DRIVER=log
MAIL_FROM=no-reply@psikologia.id
MAIL_FROM_NAME="Psikologia Career"

# CV uploads
CV_MAX_BYTES=2097152
CV_STORE_FILES=true           # false on stateless hosts (Vercel): only the analysis is stored

# Rate limits (max requests per window) — defaults shown
# RL_LOGIN_MAX=8              # per 15 min per IP+email
# RL_REGISTER_MAX=6           # per hour per IP
# RL_FORGOT_MAX=4             # per hour per IP
# RL_REFLECTION_MAX=30        # per hour per IP (guest preview)
# RL_ASSISTANT_MAX=20         # per 10 min per user
# RL_CV_MAX=6                 # per hour per user
# RL_INTERVIEW_MAX=40         # per hour per user

# Maintenance: enables POST /api/ops/migrate (header X-Ops-Token). Leave EMPTY unless needed
# (e.g. on Vercel without shell). Use >= 32 random chars and remove after migrating.
OPS_TOKEN=
