{
    "name": "psikologia/career-backend",
    "description": "Psikologia Career REST API (PHP 8.2+)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "anthropic-ai/sdk": "^1.3",
        "guzzlehttp/guzzle": "^8.3",
        "smalot/pdfparser": "^2.13"
    },
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "config": {
        "platform": { "php": "8.2.0" },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "migrate": "php bin/migrate.php"
    },
    "require-dev": {
        "phpunit/phpunit": "^11"
    }
}
