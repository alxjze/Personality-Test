{
    "name": "psikologia/career-vercel",
    "description": "Composer manifest used ONLY by the Vercel PHP runtime (api/index.php). Hostinger uses backend/composer.json.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "anthropic-ai/sdk": "^1.3",
        "guzzlehttp/guzzle": "^8.3",
        "smalot/pdfparser": "^2.13"
    },
    "autoload": {
        "psr-4": {
            "App\\": "backend/src/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true
    }
}